---
import Layout from '../../layouts/Layout.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import { getCollection } from 'astro:content';
import { it as t } from '../../i18n';

const outputStreams = t.outputs.streams.map((s) => ({ ...s, items: [] as any[] }));

const updatePosts = await getCollection('updates', ({ data }) => !data.draft);
const updates = updatePosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((p) => ({
    date: p.data.date.toISOString().slice(0, 10),
    title: p.data.title,
    excerpt: p.data.excerpt,
  }));
---

<Layout title={t.siteTitle} description={t.siteDescription} lang="it" t={t}>

  <!-- ───────────────── HERO ───────────────── -->
  <section class="hero">
    <div class="hero__gradient" aria-hidden="true"></div>
    <div class="container hero__inner">
      <aside class="hero__meta">
        <p class="meta-line">§&nbsp;CLICOPRE</p>
        <p class="meta-line">Comunicazione climatica e risposta politica agli eventi meteorologici estremi</p>
        <p class="meta-line">2026 — 2029</p>
      </aside>

      <div class="hero__main">
        <p class="eyebrow reveal">{t.hero.eyebrow}</p>

        <h1 class="hero__title reveal" data-delay="1">
          <em>{t.hero.titleEm}</em><br />{t.hero.titleRest}
        </h1>

        <p class="hero__lede reveal" data-delay="2">
          {t.hero.lede}
        </p>

        <div class="hero__cta reveal" data-delay="3">
          <a class="btn btn-primary" href="#research">
            {t.hero.ctaPrimary} <span class="arrow">→</span>
          </a>
          <a class="btn btn-ghost" href="#approach">
            {t.hero.ctaSecondary} <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────── SCOPE STRIP ───────────────── -->
  <section class="scope-strip" aria-label="Portata del progetto">
    <div class="container scope-strip__inner">
      <div class="scope-strip__cell reveal">
        <span class="scope-strip__label">{t.scopeStrip.dataLabel}</span>
        {t.scopeStrip.dataValues.map((v) => <span class="scope-strip__value">{v}</span>)}
      </div>
      <div class="scope-strip__cell reveal" data-delay="1">
        <span class="scope-strip__label">{t.scopeStrip.coverageLabel}</span>
        <span class="scope-strip__value">UE (<span class="count-up" data-target="15">0</span> paesi)</span>
        <span class="scope-strip__value">USA</span>
      </div>
      <div class="scope-strip__cell reveal" data-delay="2">
        <span class="scope-strip__label">{t.scopeStrip.periodLabel}</span>
        <span class="scope-strip__value tabular"><span class="count-up" data-target="2000">0</span>&nbsp;-&nbsp;<span class="count-up" data-target="2024">0</span></span>
      </div>
      <div class="scope-strip__cell reveal" data-delay="3">
        <span class="scope-strip__label">{t.scopeStrip.methodsLabel}</span>
        {t.scopeStrip.methodsValues.map((v) => <span class="scope-strip__value">{v}</span>)}
      </div>
    </div>
  </section>

  <!-- ───────────────── §I RICERCA ───────────────── -->
  <section id="research">
    <div class="container">
      <header class="section-head reveal">
        <div class="section-rail">
          <span class="section-marker">{t.research.marker}</span>
        </div>
        <h2>{t.research.heading}</h2>
      </header>

      <div class="pillars">
        {t.research.pillars.map((p, i) => (
          <article class="pillar reveal" tabindex="0" data-delay={String(i + 1)}>
            <header class="pillar__head">
              <span class="pillar__n tabular">— {p.n}</span>
              <h3 class="pillar__title">{p.title}</h3>
            </header>
            <p class="pillar__body">{p.body}</p>
            <ul class="pillar__keys">
              {p.keys.map((k) => <li>{k}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="newsfeed" lang="it" />

  <!-- ───────────────── §II METODI ───────────────── -->
  <section id="approach" class="alt">
    <div class="container">
      <header class="section-head reveal">
        <div class="section-rail">
          <span class="section-marker">{t.approach.marker}</span>
        </div>
        <h2>{t.approach.heading}</h2>
      </header>

      <ul class="approach__list">
        {t.approach.items.map((a, i) => (
          <li class="approach__item reveal" data-delay={String(i + 1)}>
            <span class="approach__label">{a.label}</span>
            <p>{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <SectionDivider variant="network" lang="it" />

  <!-- ───────────────── §III PERSONE ───────────────── -->
  <section id="people">
    <div class="container two-col">
      <header class="section-head reveal">
        <div class="section-rail">
          <span class="section-marker">{t.people.marker}</span>
        </div>
        <h2>{t.people.headingPre}<strong><span class="inst inst--unipd">{t.people.headingUnipd}</span></strong> {t.people.headingMid} <strong><span class="inst inst--harvard">{t.people.headingHarvard}</span></strong>.</h2>
      </header>
      <div class="reveal" data-delay="1">
        <p>
          {t.people.para1Pre} <a class="link" href="https://www.dgdi.me" target="_blank" rel="noreferrer">Duccio Gamannossi degl&rsquo;Innocenti</a>{t.people.para1Post}
        </p>
        <p>
          {t.people.para2Pre} <a class="link" href="https://www.unipd.it/en/msca-seal-excellence2025" target="_blank" rel="noreferrer"><strong>MSCA Seal of Excellence@UNIPD</strong></a>{t.people.para2Mid1} <a class="link" href="https://www.economia.unipd.it/en" target="_blank" rel="noreferrer">{t.people.para2DeptName}</a>
          {' '}{t.people.para2Mid2}<strong>{t.people.para2UnipdShort}</strong>{t.people.para2Mid3} <a class="link" href="https://gov.harvard.edu" target="_blank" rel="noreferrer">{t.people.para2HarvardDept}</a>,
          <strong>{t.people.para2HarvardShort}</strong>.
        </p>
      </div>
    </div>
  </section>

  <SectionDivider variant="contour" lang="it" />

  <!-- ───────────────── §IV RISULTATI ───────────────── -->
  <section id="outputs" class="alt">
    <div class="container">
      <header class="section-head reveal">
        <div class="section-rail">
          <span class="section-marker">{t.outputs.marker}</span>
        </div>
        <h2>{t.outputs.heading}</h2>
      </header>

      <div class="streams">
        {outputStreams.map((s, i) => (
          <article class="stream reveal" data-delay={String(i + 1)}>
            <header class="stream__head">
              <span class="stream__label">{s.label}</span>
              <span class="stream__count tabular">— {s.items.length}</span>
            </header>
            {s.items.length === 0 ? (
              <p class="stream__empty">{s.hint}</p>
            ) : (
              <ul class="stream__list">
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider variant="rollcall" lang="it" />

  <!-- ───────────────── §V AGGIORNAMENTI ───────────────── -->
  <section id="updates">
    <div class="container">
      <header class="section-head reveal">
        <div class="section-rail">
          <span class="section-marker">{t.updates.marker}</span>
        </div>
        <h2>{t.updates.heading}</h2>
      </header>

      {updates.length === 0 ? (
        <div class="updates__empty reveal" data-delay="1">
          <span class="meta-line">{t.updates.emptyLabel}</span>
          <p>{t.updates.emptyBody}</p>
        </div>
      ) : (
        <ul class="updates__list">
          {updates.map((u, i) => (
            <li class="update reveal" data-delay={String(i + 1)}>
              <a href={u.href ?? '#'} class="update__link">
                <span class="update__date meta-line">{u.date}</span>
                <h3 class="update__title">{u.title}</h3>
                <p class="update__excerpt">{u.excerpt}</p>
                <span class="update__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <SectionDivider variant="policy" lang="it" />

  <!-- ───────────────── §VI CONTATTI ───────────────── -->
  <section id="contact" class="alt tight">
    <div class="container contact">
      <header class="section-head reveal">
        <div class="section-rail">
          <span class="section-marker">{t.contact.marker}</span>
        </div>
        <h2>{t.contact.heading}</h2>
      </header>
      <p class="reveal" data-delay="1">
        {t.contact.body} <a class="obf-email" data-u="info" data-d="clicopre.com" href="#"></a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  // ── Count-up animation ──
  const counters = document.querySelectorAll<HTMLElement>('.count-up');
  if (counters.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        const target = parseInt(el.dataset.target || '0', 10);
        const duration = target > 100 ? 1200 : 800;
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const ease = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(ease * target));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        io.unobserve(el);
      }
    }, { threshold: 0.5 });
    counters.forEach((c) => io.observe(c));
  }

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Typing reveal on hero title italic ──
  if (!reducedMotion) {
    const em = document.querySelector<HTMLElement>('.hero__title em');
    if (em) {
      const text = em.textContent || '';
      em.textContent = '';
      em.style.borderRight = '2px solid var(--c-teal)';
      let i = 0;
      const type = () => {
        if (i < text.length) {
          em.textContent = text.slice(0, i + 1);
          i++;
          setTimeout(type, 45 + Math.random() * 30);
        } else {
          setTimeout(() => { em.style.borderRight = 'none'; }, 600);
        }
      };
      setTimeout(type, 800);
    }
  }

  // ── Pillar card 3D tilt on hover ──
  const pillars = document.querySelectorAll<HTMLElement>('.pillar');
  if (!reducedMotion) {
    pillars.forEach((card) => {
      card.style.transition += ', transform 0.3s ease';
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(600px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
      });
    });
  }
</script>

<style>
  /* Styles are identical to the English page — all shared via the same
     design tokens. Only content strings differ. */
  .hero {
    position: relative;
    padding-top: clamp(5rem, 11vw, 9.5rem);
    padding-bottom: 0;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__gradient {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.12;
    background: linear-gradient(
      135deg,
      var(--ws-1) 0%, var(--ws-2) 14%, var(--ws-3) 28%,
      var(--ws-4) 42%, var(--ws-5) 56%, var(--ws-6) 70%,
      var(--ws-7) 84%, var(--ws-1) 100%
    );
    background-size: 300% 300%;
    animation: heroGradientShift 20s ease infinite;
  }
  @keyframes heroGradientShift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__gradient { animation: none; }
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 6.5rem);
  }
  .hero__meta {
    display: grid;
    align-content: start;
    gap: 0.18rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--c-line);
  }
  .hero__meta .meta-line { margin: 0; }
  @media (max-width: 880px) {
    .hero__inner { grid-template-columns: 1fr; gap: 1.6rem; }
    .hero__main { order: 1; }
    .hero__meta {
      order: 2;
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 1.4rem;
      padding-top: 1.1rem;
      margin-top: 0.4rem;
    }
  }
  .hero__title {
    font-size: clamp(2.6rem, 6.2vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0.4rem 0 1.6rem;
    max-width: 18ch;
    text-wrap: balance;
  }
  .hero__title em {
    font-style: italic;
    color: var(--c-teal-deep);
    font-variation-settings: "opsz" 144, "SOFT" 100, "WONK" 1;
  }
  .hero__lede {
    font-size: var(--step-1);
    color: var(--c-ink-soft);
    max-width: 58ch;
    margin: 0 0 2.2rem;
    line-height: 1.55;
  }
  .hero__cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--c-line);
  }
  @media (max-width: 880px) { .pillars { grid-template-columns: 1fr; } }
  .pillar {
    position: relative;
    padding: 2rem 1.8rem 2.4rem 0;
    border-right: 1px solid var(--c-line);
    transition: background-color 0.4s ease;
  }
  .pillar:last-child { border-right: none; }
  @media (max-width: 880px) {
    .pillar { border-right: none; border-bottom: 1px solid var(--c-line); padding: 1.8rem 0 2rem; }
    .pillar:last-child { border-bottom: none; }
  }
  .pillar__head { display: flex; align-items: baseline; gap: 0.9rem; margin-bottom: 0.7rem; }
  .pillar__n { font-family: var(--f-mono); font-size: 0.78rem; font-weight: 500; color: var(--c-teal-deep); letter-spacing: 0.04em; }
  .pillar__title { margin: 0; font-size: var(--step-2); }
  .pillar__body { margin: 0 0 1.3rem; color: var(--c-ink-soft); max-width: 32ch; }
  .pillar__keys {
    list-style: none; margin: 0; padding: 1rem 0 0;
    border-top: 1px dashed var(--c-line);
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem;
  }
  .pillar__keys li { font-family: var(--f-mono); font-size: 0.7rem; color: var(--c-ink-muted); letter-spacing: 0.02em; }
  .pillar__keys li::before { content: "· "; color: var(--c-teal); margin-right: 0.15rem; }
  .pillar:hover, .pillar:focus-visible { background: color-mix(in srgb, var(--c-teal) 5%, transparent); }
  .pillar:focus-visible { outline: 2px solid var(--c-teal-deep); outline-offset: -2px; }

  .scope-strip {
    padding-block: clamp(2.4rem, 4vw, 3.2rem);
    border-top: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
    background: var(--c-bg-deep);
  }
  .scope-strip__inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.5vw, 2.4rem);
  }
  @media (max-width: 760px) { .scope-strip__inner { grid-template-columns: repeat(2, 1fr); gap: 1.6rem 1.4rem; } }
  .scope-strip__cell { display: grid; gap: 0.5rem; padding-left: 1rem; border-left: 1px solid var(--c-line-strong); align-content: start; }
  .scope-strip__label { font-family: var(--f-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-teal-deep); }
  .scope-strip__value { font-family: var(--f-display); font-variation-settings: "opsz" 36, "SOFT" 30, "WONK" 0; font-size: var(--step-2); font-weight: 400; color: var(--c-ink); line-height: 1.1; letter-spacing: -0.012em; }

  .approach__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 3rem); list-style: none; margin: 0; padding: 0; }
  @media (max-width: 880px) { .approach__list { grid-template-columns: 1fr; } }
  .approach__item { border-top: 1px solid var(--c-line-strong); padding-top: 1.4rem; }
  .approach__label { display: block; font-family: var(--f-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-teal-deep); margin-bottom: 0.7rem; }
  .approach__item p { margin: 0; color: var(--c-ink-soft); }

  .two-col { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  @media (max-width: 880px) { .two-col { grid-template-columns: 1fr; } }
  .two-col .section-head { margin-bottom: 0; }
  .two-col p { max-width: var(--max-w-prose); }
  .two-col strong { color: var(--c-ink); font-weight: 500; }
  .inst--unipd   { color: #9B0014; }
  .inst--harvard { color: #A51C30; }
  .section-head h2 { font-weight: 360; font-variation-settings: "opsz" 96, "SOFT" 22, "WONK" 0; letter-spacing: -0.016em; }

  .streams { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--c-line); border-bottom: 1px solid var(--c-line); }
  @media (max-width: 880px) { .streams { grid-template-columns: 1fr; } }
  .stream { padding: 1.8rem 1.6rem 2rem 0; border-right: 1px solid var(--c-line); }
  .stream:last-child { border-right: none; }
  @media (max-width: 880px) { .stream { border-right: none; border-bottom: 1px solid var(--c-line); padding: 1.6rem 0; } .stream:last-child { border-bottom: none; } }
  .stream__head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.8rem; margin-bottom: 1rem; }
  .stream__label { font-family: var(--f-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-teal-deep); }
  .stream__count { font-family: var(--f-mono); font-size: 0.7rem; color: var(--c-ink-muted); }
  .stream__empty { margin: 0; color: var(--c-ink-muted); font-size: var(--step--1); line-height: 1.55; max-width: 28ch; }

  .updates__empty { border-top: 1px solid var(--c-line); padding-top: 1.6rem; max-width: 56ch; }
  .updates__empty p { margin-top: 0.6rem; color: var(--c-ink-soft); }
  .updates__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--c-line); }
  .update { border-bottom: 1px solid var(--c-line); }
  .update__link { display: grid; grid-template-columns: 7rem 1fr auto; gap: 0.4rem 1.6rem; align-items: baseline; padding: 1.6rem 0; color: inherit; transition: background-color 0.3s ease; }
  @media (max-width: 760px) { .update__link { grid-template-columns: 1fr auto; gap: 0.3rem 1rem; } .update__date { grid-column: 1 / -1; } }
  .update__date { margin: 0; color: var(--c-ink-muted); }
  .update__title { margin: 0; font-size: var(--step-2); line-height: 1.15; }
  .update__excerpt { grid-column: 2 / 3; margin: 0.5rem 0 0; color: var(--c-ink-soft); max-width: 58ch; }
  @media (max-width: 760px) { .update__excerpt { grid-column: 1 / -1; } }
  .update__arrow { align-self: center; font-family: var(--f-mono); color: var(--c-ink-muted); transform: translateX(-4px); opacity: 0; transition: opacity 0.4s var(--ease), transform 0.4s var(--ease), color 0.3s ease; }
  .update__link:hover { background: color-mix(in srgb, var(--c-teal) 4%, transparent); }
  .update__link:hover .update__arrow { opacity: 1; transform: translateX(0); color: var(--c-teal-deep); }

  .contact .section-head { margin-bottom: 1.2rem; }
</style>

---
import '../styles/fonts.js';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import type { Lang, Translations } from '../i18n';
import { createHash } from 'node:crypto';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  t?: Translations;
  canonicalPath?: string;
  alternateEnPath?: string;
  alternateItPath?: string;
  navBasePath?: string;
}

const {
  title = 'CLICOPRE — Climate Communication & Political Response',
  description = 'CLICOPRE studies how extreme weather events shape climate communication and political response in the EU and the US. A research project by Duccio Gamannossi degl\u2019Innocenti (University of Padua, Harvard University).',
  lang = 'en',
  t,
  canonicalPath = lang === 'it' ? '/it/' : '/',
  alternateEnPath = '/',
  alternateItPath = '/it/',
  navBasePath = '',
} = Astro.props;

const siteUrl = (Astro.site ?? new URL('https://clicopre.com')).origin;
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const alternateEnUrl = new URL(alternateEnPath, siteUrl).href;
const alternateItUrl = new URL(alternateItPath, siteUrl).href;
const ogImage = `${siteUrl}/og.png`;

// Schema.org JSON-LD — helps Google Scholar and academic crawlers
// recognise this as a research project, with the PI as a Person.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ResearchProject',
      '@id': `${siteUrl}/#project`,
      name: 'CLICOPRE',
      alternateName: 'Climate Communication & Political Response',
      description,
      url: siteUrl,
      inLanguage: lang,
      funding: {
        '@type': 'Grant',
        name: 'Marie Skłodowska-Curie Actions — Seal of Excellence',
        funder: [
          {
            '@type': 'Organization',
            name: 'Università degli Studi di Padova',
            url: 'https://www.unipd.it/',
          },
          {
            '@type': 'Organization',
            name: 'Fondazione Cassa di Risparmio di Padova e Rovigo',
            url: 'https://www.fondazionecariparo.it/',
          },
        ],
      },
      member: { '@id': `${siteUrl}/#pi` },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#pi`,
      name: 'Duccio Gamannossi degl’Innocenti',
      jobTitle: 'Principal Investigator',
      sameAs: [
        'https://orcid.org/0000-0002-3653-216X',
        'https://www.dgdi.me',
      ],
      affiliation: [
        { '@type': 'Organization', name: 'Università degli Studi di Padova' },
        { '@type': 'Organization', name: 'Harvard University' },
      ],
    },
  ],
};

// Escape '<' so future dynamic descriptions cannot terminate the JSON-LD
// script element. Astro's CSP integration hashes this block during the build.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
Astro.csp.insertScriptHash(
  `sha256-${createHash('sha256').update(jsonLdText).digest('base64')}`,
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Duccio Gamannossi degl'Innocenti" />
    <meta name="keywords" content="climate communication, extreme weather, political response, NLP, causal inference, EU, US, MSCA, Marie Curie, University of Padua, Harvard" />
    <meta name="theme-color" content="#f4f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Fonts are self-hosted at build time (src/styles/fonts.js); no third-party font request is made. -->
    <title>{title}</title>

    <!-- LLM-friendly site summary -->
    <link rel="alternate" type="text/markdown" title="LLM site summary" href="/llms.txt" />

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="CLICOPRE — Updates" href="/rss.xml" />

    <!-- If JS is disabled, scroll-reveal stays open instead of leaving content invisible. -->
    <noscript>
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    </noscript>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <!-- hreflang — both language versions always reference each other -->
    <link rel="alternate" hreflang="en" href={alternateEnUrl} />
    <link rel="alternate" hreflang="it" href={alternateItUrl} />
    <link rel="alternate" hreflang="x-default" href={alternateEnUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CLICOPRE — How climate shocks shape political communication and the policy response." />
    <meta property="og:site_name" content="CLICOPRE" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Scholar / academic indexing -->
    <meta name="citation_title" content="CLICOPRE — Climate Communication & Political Response" />
    <meta name="citation_author" content="Gamannossi degl'Innocenti, Duccio" />
    <meta name="citation_publication_date" content="2026" />
    <meta name="citation_abstract" content={description} />
    <meta name="citation_language" content={lang} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={jsonLdText} />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body data-lang-en-href={alternateEnPath} data-lang-it-href={alternateItPath}>
    <a class="skip-link" href="#main">{lang === 'it' ? 'Vai al contenuto' : 'Skip to content'}</a>
    <Header
      lang={lang}
      t={t}
      navBasePath={navBasePath}
      enHref={alternateEnPath}
      itHref={alternateItPath}
    />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} t={t} navBasePath={navBasePath} />
    <ThemeSwitcher />

    <!-- Language-preference redirect — only fires on first visit after explicit toggle -->
    <script>
      (function () {
        const currentLang = document.documentElement.lang;
        const stored = localStorage.getItem('clicopre-lang');
        if (!stored || stored === currentLang) return;
        const target = stored === 'it'
          ? document.body.dataset.langItHref
          : document.body.dataset.langEnHref;
        if (target) location.replace(target + location.hash);
      })();
    </script>

    <!-- Restore scroll position after language toggle -->
    <script>
      (function () {
        const y = sessionStorage.getItem('clicopre-scroll');
        if (!y) return;
        sessionStorage.removeItem('clicopre-scroll');
        // Use rAF to ensure layout is painted before scrolling
        requestAnimationFrame(() => window.scrollTo({ top: parseInt(y, 10), behavior: 'instant' }));
      })();
    </script>

    <script>
      // Scroll-reveal via IntersectionObserver — no library.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <script>
      // Scroll-spy — highlights the nav link for the section currently in view.
      const sections = document.querySelectorAll<HTMLElement>('section[id]');
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('.site-nav a[href^="#"]');
      if (sections.length && navLinks.length) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const id = e.target.id;
              const link = document.querySelector(`.site-nav--inline a[href="#${id}"]`);
              if (link) link.classList.toggle('is-active', e.isIntersecting);
            }
          },
          { rootMargin: '-20% 0px -60% 0px' }
        );
        sections.forEach((s) => spy.observe(s));
      }
    </script>

    <script>
      // Inject mailto href into obfuscated email links (keeps address out of HTML text nodes).
      document.querySelectorAll<HTMLAnchorElement>('.obf-email').forEach((a) => {
        if (a.dataset.u && a.dataset.d) {
          a.href = 'mailto:' + a.dataset.u + '@' + a.dataset.d;
        }
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
        background: var(--c-ink);
        color: var(--c-bg);
        padding: 0.6rem 1rem;
        border-radius: 6px;
        z-index: 100;
      }
    </style>
  </body>
</html>
